{
    "name": "mammothwp/wp-release",
    "description": "Prepare, verify and ship a Mammoth WP plugin release to wordpress.org and GitHub.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://mammothwp.com",
    "support": {
        "email": "info@mammothwp.com",
        "source": "https://github.com/mammothwp/wp-release"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/filesystem": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.11 || ^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": { "MammothWP\\WPRelease\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MammothWP\\WPRelease\\Tests\\": "tests/" }
    },
    "bin": ["bin/mmwp-release"],
    "scripts": {
        "lint": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable"
}
