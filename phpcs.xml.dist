<?xml version="1.0"?>
<ruleset name="mammothwp/wp-release">
    <description>PSR-12 for the wp-release CLI package.</description>
    <file>src</file>
    <file>bin</file>
    <file>tests/Unit</file>
    <file>tests/Integration</file>
    <file>tests/Support</file>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="200"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
